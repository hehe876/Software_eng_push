# ---- Secrets : NEVER commit these ----
# We don't use a .env file (see RUN.md — config is passed via
# --dart-define), but this stays in case anything ever adds one back.
.env
.env.local
.env.*.local

# ---- Flutter / Dart ----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
*.g.dart
*.freezed.dart

# ---- Platform build output ----
android/app/debug
android/app/profile
android/app/release
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Pods/
ios/.symlinks/

# ---- Editors ----
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.swp

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
logs/
*.log

# ---- Misc ----
*.pem
.cache/
